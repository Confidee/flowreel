# flowreel staging settings: a TEMPLATE showing the shape, never real values.
#
# Recommended: inject these into the environment for one run from a password
# manager, e.g.
#   FLOWREEL_TARGET=staging <your password manager's run command> -- npm run flowreel -- --staging-only
# Or copy this file OUTSIDE the repository (the path is `secrets.file` in
# flowreel.config.ts, default ~/.config/flowreel/staging.env) and run
#   chmod 600 ~/.config/flowreel/staging.env
# flowreel refuses a secrets file other users can read. Process env always
# overrides it. FLOWREEL_TARGET is never read from this file: a run is a
# staging run only when you ask for it. Local runs never read it.

# The staging origin; must be listed in flowreel.config.ts targets.staging.
FLOWREEL_BASE_URL=https://staging.example.com

# One email + password per persona in flowreel.config.ts `personas`.
# Dedicated QA accounts only, never a real person's account.
FLOWREEL_USER_EMAIL=qa-user@example.com
FLOWREEL_USER_PASSWORD=change-me
FLOWREEL_ADMIN_EMAIL=qa-admin@example.com
FLOWREEL_ADMIN_PASSWORD=change-me
